{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/analyze.js": {
      "maxDuration": 60
    },
    "api/approve.js": {
      "maxDuration": 15
    },
    "api/settle.js": {
      "maxDuration": 30
    },
    "api/reconcile.js": {
      "maxDuration": 20
    },
    "api/payments.js": {
      "maxDuration": 15
    },
    "api/payment.js": {
      "maxDuration": 15
    },
    "api/health.js": {
      "maxDuration": 10
    },
    "api/agent.js": {
      "maxDuration": 45
    },
    "api/settlement-network.js": {
      "maxDuration": 15
    },
    "api/celo-v2.js": {
      "maxDuration": 20
    }
  },
  "rewrites": [
    {
      "source": "/v2",
      "destination": "/v2.html"
    },
    {
      "source": "/api/settlement-health",
      "destination": "/api/settlement-network?action=health"
    },
    {
      "source": "/api/settlement-quote",
      "destination": "/api/settlement-network?action=quote"
    },
    {
      "source": "/api/settlement-execute",
      "destination": "/api/settlement-network?action=execute"
    },
    {
      "source": "/api/beneficiaries",
      "destination": "/api/payments?kind=beneficiaries&limit=100"
    },
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/index.html"
    }
  ]
}
